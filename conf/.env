APP_URL=https://__DOMAIN____PATH__
PORT=__PORT__
JWT_TOKEN_EXPIRES_IN=30d
STORAGE_DRIVER=local
DISABLE_TELEMETRY=true

# Databases
DATABASE_URL=postgresql://__DB_USER__:__DB_PWD__@:5432/__DB_NAME__
REDIS_URL=redis://127.0.0.1:6379/__REDIS_DB__
APP_SECRET='__APP_SECRET__'

# EMAILS
MAIL_DRIVER=smtp
SMTP_HOST=__DOMAIN__
SMTP_PORT=587
SMTP_USERNAME=__APP__
SMTP_PASSWORD=__MAIL_PWD__
SMTP_SECURE=true
MAIL_FROM_ADDRESS=__APP__@__DOMAIN__
MAIL_FROM_NAME=__APP__